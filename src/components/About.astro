---
import { Image } from 'astro:assets'
import myImage from '../assets/me.jpg'
import { Card } from './ui/card'

// const stats = [
//   { number: '50+', label: 'Projects Completed' },
//   { number: '5+', label: 'Years Experience' },
//   { number: '20+', label: 'Technologies Mastered' },
// ]
---

<section id="about" class="py-20 px-6">
  <div class="max-w-6xl mx-auto">
    <div
      id="about-content"
      class="transition-all duration-1000 opacity-0 translate-y-10"
    >
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">
          <span class="text-primary">About</span> Me
        </h2>
        <div class="w-24 h-1 bg-primary mx-auto rounded-full"></div>
      </div>

      <!-- About Sections -->
      <div class="space-y-16">
        <!-- My Journey -->
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div class="order-2 md:order-1">
            <div class="relative w-64 h-64 md:w-80 md:h-80">
              <div
                class="absolute inset-0 border-2 border-red-500 rounded-md transform rotate-6"
              >
              </div>
              <div
                class="absolute inset-0 bg-zinc-900 rounded-md overflow-hidden"
              >
                <Image
                  src={myImage}
                  alt="Ignacio Barraza"
                  width={300}
                  height={300}
                  class="w-full max-w-[300px] md:max-w-none object-cover"
                />
              </div>
            </div>
          </div>

          <div class="order-1 md:order-2 space-y-6">
            <h3 class="text-2xl font-bold text-primary mb-4">My Journey</h3>
            <div class="space-y-4 text-primary-foreground leading-relaxed">
              <p>
                Full-stack software engineer with 3+ years of experience
                building scalable web solutions and APIs. I specialize in the
                TypeScript ecosystem (Angular, Node.js, Express, TypeORM). I
                master REST API design, efficient database modeling, and focus
                on accessibility standards (WCAG). My commitment to continuous
                improvement (Kaizen) allows me to rapidly integrate cutting-edge
                technologies like Next.js, Astro, NestJS, and GraphQL.
              </p>
              <p>
                My approach emphasizes well-structured architectures, such as
                hexagonal design, to ensure maintainability and flexibility. I
                strive for clean, modular code while balancing technical
                excellence with practical, real-world application.
              </p>
              <p>
                My development philosophy is inspired by 'Wabi-sabi' (侘寂) -
                finding beauty in imperfection and accepting the natural cycle
                of growth and decay. This translates to creating software that
                is both beautiful and practical, embracing simplicity and
                authenticity.
              </p>
            </div>
          </div>
        </div>

        <!-- Personal Philosophy -->
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div class="space-y-6">
            <h3 class="text-2xl font-bold text-primary mb-4">
              Personal Philosophy
            </h3>
            <div class="space-y-4 text-secondary-foreground leading-relaxed">
              <p>
                The best code is like a Japanese garden – carefully crafted,
                balanced, and appears simple despite the complex thought behind
                it.
              </p>
              <p>
                I believe in the Japanese concept of <span
                  class="text-primary font-semibold">'Kaizen' (改善)</span
                > - continuous improvement. Each project is an opportunity to refine
                my craft and expand my knowledge.
              </p>
            </div>
          </div>
          <Card className="surface-elevated p-8 rounded-2xl border-border/30">
            <div class="text-center space-y-4">
              <div class="text-4xl">🎯</div>
              <h4 class="text-xl font-semibold text-primary">Core Values</h4>
              <div class="space-y-3 text-sm">
                <div class="flex items-center justify-center space-x-2">
                  <span class="w-2 h-2 bg-primary rounded-full"></span>
                  <span class="text-secondary-foreground"
                    >Quality over Quantity</span
                  >
                </div>
                <div class="flex items-center justify-center space-x-2">
                  <span class="w-2 h-2 bg-primary rounded-full"></span>
                  <span class="text-secondary-foreground"
                    >Continuous Learning</span
                  >
                </div>
                <div class="flex items-center justify-center space-x-2">
                  <span class="w-2 h-2 bg-primary rounded-full"></span>
                  <span class="text-secondary-foreground"
                    >User-Centric Design</span
                  >
                </div>
              </div>
            </div>
          </Card>
        </div>
        <!-- Education & Interests -->
        <div class="grid md:grid-cols-2 gap-12">
          <!-- Education -->
          <Card className="surface-elevated p-8 rounded-2xl border-border/30">
            <h3 class="text-2xl font-bold text-primary mb-6">Education</h3>
            <div class="space-y-6">
              <div class="space-y-2">
                <h4 class="font-semibold text-primary-foreground text-xl">
                  Bachelor of Computer Science Engineering
                </h4>
                <p class="text-secondary-foreground text-sm">
                  Universidad de Tarapacá • 2021 - 2025
                </p>
                <p class="text-secondary-foreground text-sm">
                  Focus: Software Engineering
                </p>
              </div>
              <!-- <div class="space-y-2">
                <h4 class="font-semibold text-primary-foreground">
                  Certifications
                </h4>
                <ul class="space-y-1 text-sm text-secondary-foreground">
                  <li>• AWS Solutions Architect</li>
                  <li>• Google Cloud Professional</li>
                  <li>• React Advanced Certification</li>
                </ul>
              </div> -->
            </div>
          </Card>

          <!-- Interests & Hobbies -->
          <Card className="surface-elevated p-8 rounded-2xl border-border/30">
            <h3 class="text-2xl font-bold text-primary mb-6">
              Interests & Hobbies
            </h3>
            <div class="space-y-4">
              <div class="flex items-center space-x-3">
                <span class="text-2xl">🎮</span>
                <div>
                  <p class="font-medium text-secondary-foreground">
                    Game Development
                  </p>
                </div>
              </div>
              <div class="flex items-center space-x-3">
                <span class="text-2xl">📚</span>
                <div>
                  <p class="font-medium text-secondary-foreground">
                    Japanese Language (Learning)
                  </p>
                </div>
              </div>
              <div class="flex items-center space-x-3">
                <span class="text-2xl">🤖</span>
                <div>
                  <p class="font-medium text-secondary-foreground">Robotics</p>
                </div>
              </div>
              <div class="flex items-center space-x-3">
                <span class="text-2xl">⛩️</span>
                <div>
                  <p class="font-medium text-secondary-foreground">
                    Anime & Manga
                  </p>
                </div>
              </div>
            </div>
          </Card>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const content = document.getElementById('about-content')

      if (content) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                content.classList.remove('opacity-0', 'translate-y-10')
                content.classList.add('opacity-100', 'translate-y-0')
                observer.unobserve(content) // only animate once
              }
            })
          },
          { threshold: 0.3 }
        )

        observer.observe(content)
      }
    })
  </script>
</section>
