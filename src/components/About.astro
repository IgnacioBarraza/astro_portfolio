---
import { Image } from 'astro:assets'
import myImage from '../assets/profile_image.png'
import { Card } from './ui/card'
import { getLangFromUrl, getTranslations } from '@/i18n/utils'

const currentLang = getLangFromUrl(Astro.url)
const t = getTranslations(currentLang)
---

<section id="about" class="py-20 px-6">
  <div class="max-w-6xl mx-auto">
    <div
      id="about-content"
      class="transition-all duration-1000 opacity-0 translate-y-10"
    >
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">
          <span class="text-primary">{t.about.title}</span>
          {t.about.title2}
        </h2>
        <div class="w-24 h-1 bg-primary mx-auto rounded-full"></div>
      </div>

      <!-- About Sections -->
      <div class="space-y-16">
        <!-- My Journey -->
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div class="order-2 md:order-1">
            <div class="relative w-64 h-64 md:w-80 md:h-80">
              <div
                class="absolute inset-0 border-2 border-red-500 rounded-md transform rotate-6"
              >
              </div>
              <div
                class="absolute inset-0 bg-zinc-900 rounded-md overflow-hidden"
              >
                <Image
                  src={myImage}
                  alt="Ignacio Barraza"
                  width={300}
                  height={300}
                  class="w-full max-w-[300px] md:max-w-none object-cover"
                />
              </div>
            </div>
          </div>

          <div class="order-1 md:order-2 space-y-6">
            <h3 class="text-2xl font-bold text-primary mb-4">
              {t.about.journey}
            </h3>
            <div class="space-y-4 text-primary-foreground leading-relaxed">
              <p>
                {t.about.description1}
              </p>
              <p>
                {t.about.description2}
              </p>
              <p>
                {t.about.description3}
              </p>
              <p>
                {t.about.description4}
              </p>
            </div>
          </div>
        </div>

        <!-- Personal Philosophy -->
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div class="space-y-6">
            <h3 class="text-2xl font-bold text-primary mb-4">
              {t.about.philosophy}
            </h3>
            <div class="space-y-4 text-secondary-foreground leading-relaxed">
              <p>
                {t.about.philosophy_desc1}
              </p>
              <p>
                {t.about.philosophy_desc2}<span
                  class="text-primary font-semibold"
                  >{t.about.philosophy_concept}</span
                >{t.about.philosophy_desc3}
              </p>
            </div>
          </div>
          <Card className="surface-elevated p-8 rounded-2xl border-border/30">
            <div class="text-center space-y-4">
              <div class="text-4xl">🎯</div>
              <h4 class="text-xl font-semibold text-primary">
                {t.about.values}
              </h4>
              <div class="space-y-3 text-sm">
                <div class="flex items-center justify-center space-x-2">
                  <span class="w-2 h-2 bg-primary rounded-full"></span>
                  <span class="text-secondary-foreground">{t.about.value1}</span
                  >
                </div>
                <div class="flex items-center justify-center space-x-2">
                  <span class="w-2 h-2 bg-primary rounded-full"></span>
                  <span class="text-secondary-foreground">{t.about.value2}</span
                  >
                </div>
                <div class="flex items-center justify-center space-x-2">
                  <span class="w-2 h-2 bg-primary rounded-full"></span>
                  <span class="text-secondary-foreground">{t.about.value3}</span
                  >
                </div>
              </div>
            </div>
          </Card>
        </div>
        <!-- Education & Interests -->
        <div class="grid md:grid-cols-2 gap-12">
          <!-- Education -->
          <Card className="surface-elevated p-8 rounded-2xl border-border/30">
            <h3 class="text-2xl font-bold text-primary mb-6">
              {t.about.education}
            </h3>
            <div class="space-y-6">
              <div class="space-y-2">
                <h4 class="font-semibold text-primary-foreground text-xl">
                  {t.about.education_grade}
                </h4>
                <p class="text-secondary-foreground text-sm">
                  {t.about.education_university}
                </p>
                <p class="text-secondary-foreground text-sm">
                  {t.about.education_focus}
                </p>
              </div>
              <!-- <div class="space-y-2">
                <h4 class="font-semibold text-primary-foreground">
                  Certifications
                </h4>
                <ul class="space-y-1 text-sm text-secondary-foreground">
                  <li>• AWS Solutions Architect</li>
                  <li>• Google Cloud Professional</li>
                  <li>• React Advanced Certification</li>
                </ul>
              </div> -->
            </div>
          </Card>

          <!-- Interests & Hobbies -->
          <Card className="surface-elevated p-8 rounded-2xl border-border/30">
            <h3 class="text-2xl font-bold text-primary mb-6">
              {t.about.interests}
            </h3>
            <div class="space-y-4">
              <div class="flex items-center space-x-3">
                <span class="text-2xl">🎮</span>
                <div>
                  <p class="font-medium text-secondary-foreground">
                    {t.about.interest1}
                  </p>
                </div>
              </div>
              <div class="flex items-center space-x-3">
                <span class="text-2xl">📚</span>
                <div>
                  <p class="font-medium text-secondary-foreground">
                    {t.about.interest2}
                  </p>
                </div>
              </div>
              <div class="flex items-center space-x-3">
                <span class="text-2xl">🤖</span>
                <div>
                  <p class="font-medium text-secondary-foreground">
                    {t.about.interest3}
                  </p>
                </div>
              </div>
              <div class="flex items-center space-x-3">
                <span class="text-2xl">⛩️</span>
                <div>
                  <p class="font-medium text-secondary-foreground">
                    {t.about.interest4}
                  </p>
                </div>
              </div>
            </div>
          </Card>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const content = document.getElementById('about-content')

      if (content) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                content.classList.remove('opacity-0', 'translate-y-10')
                content.classList.add('opacity-100', 'translate-y-0')
                observer.unobserve(content) // only animate once
              }
            })
          },
          { threshold: 0.1 },
        )

        observer.observe(content)
      }
    })
  </script>
</section>
