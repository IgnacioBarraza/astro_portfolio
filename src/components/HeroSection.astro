---
import { ArrowDown, Github, Linkedin, Mail } from '@lucide/astro'
import { Button } from './ui/button'
import { CvDownloadModal } from './DownloadCv'

const network = [
  {
    icon: Github,
    label: 'GitHub',
    href: 'https://github.com/IgnacioBarraza#',
  },
  {
    icon: Linkedin,
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/ignacio-barraza-rioja/',
  },
  {
    icon: Mail,
    label: 'Email',
    href: 'mailto:ignacio.barraza.rioja@gmail.com',
  },
]
---

<section
  id="hero"
  class="min-h-screen flex items-center justify-center relative overflow-hidden"
>
  {/* Background geometric elements */}
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute top-1/4 left-1/4 w-32 h-32 border-2 border-primary/50 rotate-45 animate-float"
    >
    </div>
    <div
      class="absolute top-2/3 left-1/3 w-32 h-32 border-2 border-primary/50 rotate-20 animate-float"
    >
    </div>
    <div
      class="absolute bottom-1/4 right-1/4 w-24 h-24 border-2 border-accent/50 rotate-12 animate-float"
      style={{ animationDelay: '1s' }}
    >
    </div>
    <div
      class="absolute top-1/2 right-1/3 w-16 h-16 bg-primary/50 rotate-45 animate-float"
      style={{ animationDelay: '2s' }}
    >
    </div>
    <div
      class="absolute bottom-3/4 right-96 w-16 h-16 bg-primary/50 rotate-25 animate-float"
      style={{ animationDelay: '3s' }}
    >
    </div>
  </div>

  <div
    id="hero-content"
    class="text-center max-w-4xl mx-auto px-6 transition-all duration-1000 opacity-0 translate-y-10"
  >
    {/* Greeting */}
    <div class="mb-4">
      <span class="text-primary text-lg font-medium tracking-wider"
        >こんにちは</span
      >
      <span class="text-foreground ml-2">Hello</span>
    </div>

    {/* Main heading */}
    <h1 class="text-6xl md:text-8xl font-bold mb-6 tracking-tight">
      <span class="text-primary">Ignacio</span>
      <span class="text-foreground">Barraza</span>
    </h1>

    {/* Subtitle */}
    <div class="mb-8 space-y-2">
      <p class="text-xl md:text-2xl text-primary font-bold">
        Software Engineer
      </p>
      <p class="text-primary-foreground max-w-2xl mx-auto leading-relaxed">
        Crafting digital experiences with precision and elegance. Building
        modern web applications with a focus on performance and design.
      </p>
    </div>

    {/* CTA Buttons */}
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
      <a
        href="#projects"
        class="flex items-center justify-center group gradient-primary px-4 py-2 text-lg font-medium rounded-full hover:scale-105 transition-all duration-300 glow-hover cursor-pointer"
      >
        View My Work
        <ArrowDown
          class="ml-2 h-5 w-5 group-hover:translate-y-1 transition-transform"
        />
      </a>

      <CvDownloadModal client:load />
    </div>

    {/* Social Links */}
    <div class="flex justify-center space-x-6">
      {
        network.map(({ icon: Icon, label, href }) => (
          <a
            href={href}
            class="p-3 rounded-full border border-primary/50 hover:border-primary hover:bg-primary/10 transition-all duration-300 group"
            aria-label={label}
            target="_blank"
          >
            <Icon class="h-5 w-5 text-primary-foreground group-hover:text-primary transition-colors" />
          </a>
        ))
      }
    </div>
  </div>

  {/* Scroll indicator */}
  <div
    class="absolute bottom-24 left-1/2 transform -translate-x-1/2 animate-bounce"
  >
    <ArrowDown class="h-6 w-6 text-primary" />
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const content = document.getElementById('hero-content')

    if (content) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              content.classList.remove('opacity-0', 'translate-y-10')
              content.classList.add('opacity-100', 'translate-y-0')
              observer.unobserve(content)
            }
          })
        },
        { threshold: 0.3 }
      )

      observer.observe(content)
    }
  })
</script>
