---
import ContactForm from '@/components/ContactForm'
import { Card } from '@/components/ui/card'
import { getLangFromUrl, getTranslations } from '@/i18n/utils'
import { Mail, MapPin, Linkedin } from 'lucide-react'

const currentLang = getLangFromUrl(Astro.url)
const t = getTranslations(currentLang)
const contactInfo = [
  {
    icon: Mail,
    label: t.contact.labels.email,
    value: 'ignacio.barraza.rioja@gmail.com',
    href: 'mailto:ignacio.barraza.rioja@gmail.com',
  },
  {
    icon: MapPin,
    label: t.contact.labels.location,
    value: t.contact.values.location,
    href: '',
  },
  {
    icon: Linkedin,
    label: t.contact.labels.linkedin,
    value: t.contact.values.linkedin,
    href: 'https://www.linkedin.com/in/ignacio-barraza-rioja/',
  },
]
---

<section
  id="contact"
  class="py-20 px-6 bg-cover bg-center bg-no-repeat relative"
>
  <div class="max-w-6xl mx-auto transition-all duration-1000">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">
        {t.contact.title}<span class="text-primary">{t.contact.title2}</span>
      </h2>
      <div class="w-24 h-1 bg-primary mx-auto rounded-full"></div>
      <p class="text-muted-foreground mt-6 max-w-2xl mx-auto">
        {t.contact.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-12">
      <!-- Contact Info -->
      <div class="space-y-8">
        <div>
          <h3 class="text-2xl font-semibold text-primary mb-6">
            {t.contact.getInTouch}
          </h3>
          <p class="text-secondary-foreground leading-relaxed mb-8">
            {t.contact.subtitle2}
          </p>
        </div>

        <div class="space-y-6">
          {
            contactInfo.map((info) => (
              <a
                href={info.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center space-x-4 p-4 rounded-xl surface-elevated border border-border/30 hover:border-primary/30 transition-all duration-300 group"
              >
                <div class="p-3 rounded-full bg-primary/10 group-hover:bg-primary/20 transition-colors">
                  <info.icon className="h-5 w-5 text-primary" />
                </div>
                <div>
                  <div class="text-sm text-muted-foreground">{info.label}</div>
                  <div class="text-foreground font-medium">{info.value}</div>
                </div>
              </a>
            ))
          }
        </div>

        <!-- Quote -->
        <Card className="surface-elevated p-6 border-border/30">
          <blockquote class="text-secondary-foreground italic">
            {t.contact.quote}
          </blockquote>
          <cite class="text-muted-foreground text-sm mt-2 block"
            >— Peter Drucker</cite
          >
        </Card>
      </div>

      <!-- Contact Form (React Island) -->
      <Card className="surface-elevated p-8 border-border/30">
        <ContactForm client:load lang={currentLang} />
      </Card>
    </div>
  </div>
</section>
